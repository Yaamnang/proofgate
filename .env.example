# ProofGate configuration. Copy to .env and fill in your values.
# cp .env.example .env

# Your Vultr Serverless Inference API key. Required for the LLM passes
# (claim extraction and the adversarial disprove pass). Without it the
# pipeline still runs using deterministic fallbacks.
VULTR_INFERENCE_API_KEY=

# The model to use. Must be a Vultr Serverless Inference model that
# supports tool calling (a kimi or llama model).
VULTR_MODEL=llama-3.3-70b-instruct

# Vultr Serverless Inference endpoint. OpenAI-compatible. Leave as is.
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1

# Port the web server listens on. The public URL is http://<VM_IP>:<PORT>.
PORT=3000

# Hard timeout per sandbox run, in seconds. The container is killed if a
# PoC runs longer than this.
SANDBOX_TIMEOUT=45

# Base image each sandbox container runs from. Pulled once at deploy.
RUNNER_IMAGE=node:22-alpine
